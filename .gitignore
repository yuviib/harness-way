# Dependencies
node_modules/

# Rust build output
target/

# Generated WASM build output -- regenerate via `npm run build:wasm` in
# apps/gateway, don't commit it; it's derived from crates/mcp-relay-engine.
apps/gateway/src/wasm/

# Wrangler-generated ambient types -- regenerate via `npx wrangler types`
# after checkout or after any wrangler.toml binding change.
worker-configuration.d.ts

# Wrangler local dev state
.wrangler/

# Wrangler's local-only var overrides -- read by `wrangler dev` alone, never
# uploaded by `wrangler deploy`. Holds SUBSCRIBE_TOKEN's dev-only value now
# that a real deployment needs the same binding name as a real secret
# (`wrangler secret put`), and a var and a secret can't share one name.
.dev.vars

# TypeScript incremental build cache
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Editor/OS
.DS_Store

# Local design-tool bookkeeping, not part of the project
.hallmark/
design.md

# Personal interview/application prep, not part of the project itself
docs/RESUME_PREP.md
