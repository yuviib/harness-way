{
  "name": "@mcp-relay-harness/gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/mcp-relay-engine --target bundler --out-dir ../../apps/gateway/src/wasm",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply mcp-relay-harness-delivery-log --local",
    "db:migrate:remote": "wrangler d1 migrations apply mcp-relay-harness-delivery-log --remote",
    "dev": "npm run db:migrate:local && wrangler dev",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
