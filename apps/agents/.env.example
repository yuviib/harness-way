# Copy to .env and fill in. .env is gitignored; never commit real values.

GATEWAY_HTTP_BASE=http://127.0.0.1:8787
GATEWAY_WS_BASE=ws://127.0.0.1:8787
SUBSCRIBE_TOKEN=dev-only-shared-secret
ORIGIN_URL=http://127.0.0.1:8794/mcp
CATEGORY=resource_changed

# Optional. summarizer-agent only runs if this is set; the other three
# agents work fully without it. Get a free-tier key from Google AI Studio.
GEMINI_API_KEY=
# Optional override; defaults to gemini-flash-latest if unset. That's a
# stable alias Google maintains, not a dated snapshot, chosen after a
# hardcoded dated model (gemini-2.0-flash) was confirmed to 404 against a
# real key's /v1beta/models list. On a 429 (quota) or 503 (overloaded),
# summarizer-agent automatically falls back across other Gemini models on
# this SAME key (see GEMINI_FALLBACK_MODELS in summarizerAgent.ts) before
# ever needing GROQ_API_KEY below.
GEMINI_MODEL=

# Optional. Only used if the ENTIRE Gemini model chain fails for a given
# notification -- a genuinely different free-tier provider as a last
# resort, not another Gemini model. Unset means this tier never runs; the
# agent behaves exactly as it did before this was added. Get a free key
# from https://console.groq.com.
GROQ_API_KEY=
